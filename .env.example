# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox

# Redis
REDIS_URL=redis://localhost:6379

# Sessions
SESSION_SECRET=change-me-in-production-use-long-random-string

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Ethereal SMTP (https://ethereal.email — create account, paste Nodemailer creds)
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=
ETHEREAL_FROM="ReachInbox <no-reply@ethereal.email>"

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=reachinbox-emails

# Slack OAuth (https://api.slack.com/apps)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback

# Workers / scheduling
WORKER_CONCURRENCY=5
MAX_ATTEMPTS=3
DEFAULT_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MIN_SEND_DELAY_MS=2000

# Bull Board (queue dashboard). Unset = dashboard disabled (safe default).
BULL_BOARD_ADMIN_EMAIL=
